FROM node:22-alpine AS build

WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM nginx:1.27-alpine
LABEL org.opencontainers.image.title="Librarry Web" \
  org.opencontainers.image.description="React web UI and nginx reverse proxy for Librarry." \
  org.opencontainers.image.source="https://github.com/bandoracer/librarry" \
  org.opencontainers.image.licenses="AGPL-3.0"
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/web/dist /usr/share/nginx/html
EXPOSE 80
