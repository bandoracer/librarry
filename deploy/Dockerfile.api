FROM golang:1.23-alpine AS build

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY backend ./backend
RUN go build -o /out/librarry ./backend/cmd/librarry

FROM alpine:3.20
RUN adduser -D -H librarry
WORKDIR /app
COPY --from=build /out/librarry /usr/local/bin/librarry
COPY backend/migrations ./backend/migrations
USER librarry
EXPOSE 8080
CMD ["librarry"]

