FROM golang:1.26.8-alpine AS build

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY backend ./backend
ARG VERSION=0.4.2-dev
ARG COMMIT=unknown
ARG BUILD_TIME
RUN go build -trimpath -ldflags "-X github.com/bandoracer/librarry/backend/internal/buildinfo.Version=${VERSION} -X github.com/bandoracer/librarry/backend/internal/buildinfo.Commit=${COMMIT} -X github.com/bandoracer/librarry/backend/internal/buildinfo.BuildTime=${BUILD_TIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" -o /out/librarry ./backend/cmd/librarry

FROM alpine:3.23
LABEL org.opencontainers.image.title="Librarry API" \
  org.opencontainers.image.description="Go API and worker for Librarry, a self-hosted ebook and audiobook manager." \
  org.opencontainers.image.source="https://github.com/bandoracer/librarry" \
  org.opencontainers.image.licenses="AGPL-3.0"
# postgresql16-client provides pg_dump for scheduled database backups
# (matches the postgres:16-alpine compose database).
RUN apk add --no-cache ca-certificates tzdata postgresql16-client \
  && adduser -D -H -u 1000 librarry
WORKDIR /app
COPY --from=build /out/librarry /usr/local/bin/librarry
COPY backend/migrations ./backend/migrations
USER librarry
EXPOSE 8080
CMD ["librarry"]
