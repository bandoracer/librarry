FROM golang:1.23-alpine AS build

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY backend ./backend
RUN go build -o /out/librarry ./backend/cmd/librarry

FROM alpine:3.20
LABEL org.opencontainers.image.title="Librarry API" \
  org.opencontainers.image.description="Go API and worker for Librarry, a self-hosted ebook and audiobook manager." \
  org.opencontainers.image.source="https://github.com/bandoracer/librarry" \
  org.opencontainers.image.licenses="AGPL-3.0"
RUN apk add --no-cache ca-certificates tzdata \
  && adduser -D -H -u 1000 librarry
WORKDIR /app
COPY --from=build /out/librarry /usr/local/bin/librarry
COPY backend/migrations ./backend/migrations
USER librarry
EXPOSE 8080
CMD ["librarry"]
